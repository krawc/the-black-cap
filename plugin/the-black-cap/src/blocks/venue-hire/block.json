{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "the-black-cap/venue-hire",
  "title": "Venue Hire",
  "description": "Interactive venue floor plan with hover-reveal info panels.",
  "category": "theme",
  "icon": "location-alt",
  "supports": { "html": false },
  "attributes": {
    "slots": {
      "type": "array",
      "default": [
        { "venueId": 0 },
        { "venueId": 0 },
        { "venueId": 0 }
      ],
      "items": {
        "type": "object",
        "properties": {
          "venueId": { "type": "integer", "default": 0 }
        }
      }
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
