{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "the-black-cap/drink-menu",
  "title": "Drink Menu",
  "description": "Drinks menu with Drinks and Wines tabs, each with collapsible subcategory accordions.",
  "category": "theme",
  "icon": "beer",
  "supports": {
    "html": false
  },
  "attributes": {
    "heading": {
      "type": "string",
      "default": "The Menu"
    },
    "tabs": {
      "type": "array",
      "default": []
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}