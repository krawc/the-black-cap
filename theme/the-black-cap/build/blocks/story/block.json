{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "the-black-cap/story",
  "title": "Story",
  "description": "The Cap Story section: headline, body copy, and a parallax photo gallery with per-photo drift controls.",
  "category": "theme",
  "icon": "format-image",
  "supports": {
    "html": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Legendary"
    },
    "copy": {
      "type": "string",
      "default": ""
    },
    "parallax": {
      "type": "boolean",
      "default": true
    },
    "photos": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "scale": {
            "type": "number",
            "default": 1
          },
          "driftX": {
            "type": "number",
            "default": 0
          },
          "driftY": {
            "type": "number",
            "default": 0
          }
        }
      }
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}