{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "the-black-cap/timeline",
  "title": "Timeline",
  "description": "History timeline with intro text, rainbow rail, and timestamped entries with lightbox gallery.",
  "category": "theme",
  "icon": "clock",
  "supports": { "html": false },
  "attributes": {
    "introText": {
      "type": "string",
      "default": ""
    },
    "timestamps": {
      "type": "array",
      "default": [],
      "items": { "type": "object" }
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
